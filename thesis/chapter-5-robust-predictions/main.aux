\newlabel{eq:diabetes-case-study}{{1.1}{3}{Illustrative example: Diabetes risk}{equation.1.2.1}{}}
\newlabel{fig:x1-shift}{{1.2a}{4}{\relax }{figure.caption.3}{}}
\newlabel{sub@fig:x1-shift}{{a}{4}{\relax }{figure.caption.3}{}}
\newlabel{fig:x2-shift}{{1.2b}{4}{\relax }{figure.caption.3}{}}
\newlabel{sub@fig:x2-shift}{{b}{4}{\relax }{figure.caption.3}{}}
\newlabel{fig:x2-pred}{{1.2c}{4}{\relax }{figure.caption.3}{}}
\newlabel{sub@fig:x2-pred}{{c}{4}{\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Causes are more consistent predictors than symptoms, although symptoms still contain important information. In (a), we can see that the probability of diabetes, $\MakeUppercase    []{y}$, conditioned on a cause of diabetes (body-mass index, $\MakeUppercase    []{x}_{c}$) remains constant across environments (i.e., regardless of whether salt intake, $\MakeUppercase    []{w}$, is 1 or 0). However, (b) shows that the probability of diabetes, $\MakeUppercase    []{y}$, conditioned on a symptom of diabetes (thirst frequency, $\MakeUppercase    []{x}_{s}$) changes across environments. Nevertheless, the probability of diabetes, $\MakeUppercase    []{y}$, changes with thirst frequency, $\MakeUppercase    []{x}_{s}$, within each environment (i.e., when the salt intake, $\MakeUppercase    []{w}$, is constant), as shown in (c).}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:x2}{{1.2}{4}{Causes are more consistent predictors than symptoms, although symptoms still contain important information. In (a), we can see that the probability of diabetes, $\myrv {y}$, conditioned on a cause of diabetes (body-mass index, $\myrv {x}_{c}$) remains constant across environments (i.e., regardless of whether salt intake, $\myrv {w}$, is 1 or 0). However, (b) shows that the probability of diabetes, $\myrv {y}$, conditioned on a symptom of diabetes (thirst frequency, $\myrv {x}_{s}$) changes across environments. Nevertheless, the probability of diabetes, $\myrv {y}$, changes with thirst frequency, $\myrv {x}_{s}$, within each environment (i.e., when the salt intake, $\myrv {w}$, is constant), as shown in (c)}{figure.caption.3}{}}
