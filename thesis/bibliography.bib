@misc{jafrastehGaussianProcessesMissing2022,
  type = {{{SSRN Scholarly Paper}}},
  title = {Gaussian {{Processes}} for {{Missing Value Imputation}}},
  author = {Jafrasteh, Bahram and {Hern{\'a}ndez-Lobato}, Daniel and {Lubi{\'a}n-L{\'o}pez}, Sim{\'o}n Pedro and {Benavente-Fern{\'a}nde}, Isabel},
  year = {2022},
  month = jul,
  number = {4170143},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4170143},
  urldate = {2023-06-21},
  abstract = {Missing values happen when a particular attribute of an instance of a machine learning problem is not recorded. They are common in many real-life datasets. However, most of the current machine learning methods~can not handle missing values. This means that they~should be imputed beforehand. Gaussian Processes (GPs) are~non-parametric models with accurate uncertainty estimates that combined with sparse approximations and stochastic~variational inference scale to large data sets. Sparse GPs can be used to compute a predictive~distribution for missing data.~~Here, we present a hierarchical composition~of sparse GPs that is used to predict missing values ateach dimension using all the variables from the other dimensions. We call the approach missing GP (MGP). MGP can be trained~simultaneously to impute all observed missing values. Specifically,~MGP outputs a predictive distribution for each missing value that is then used in the imputation of other missing values. We evaluate MGP in one private clinical data set and four~UCI datasets with a different percentage of missing values. We compare the performance of MGP with other state-of-the-art methods~for imputing missing values, including variants based on sparse GPs~and deep GPs. The results obtained show that the performance of MGP is~significantly better.},
  langid = {english},
  keywords = {Deep Gaussian processes,Deep Learning,Gaussian process,Missing values,variational inference},
  file = {C:\Users\danan\Zotero\storage\GIMU958M\Jafrasteh et al. - 2022 - Gaussian Processes for Missing Value Imputation.pdf}
}

