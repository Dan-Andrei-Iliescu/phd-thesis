@article{amatoNovelFrameworkSpatiotemporal2020,
  title = {A Novel Framework for Spatio-Temporal Prediction of Environmental Data Using Deep Learning},
  author = {Amato, Federico and Guignard, Fabian and Robert, Sylvain and Kanevski, Mikhail},
  year = {2020},
  month = dec,
  journal = {Scientific Reports},
