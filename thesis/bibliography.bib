@inproceedings{gongDomainAdaptationConditional2016,
  title = {Domain {{Adaptation}} with {{Conditional Transferable Components}}},
  booktitle = {Proceedings of {{The}} 33rd {{International Conference}} on {{Machine Learning}}},
