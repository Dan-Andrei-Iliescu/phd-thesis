  shorttitle = {To {{Ensemble}} or {{Not Ensemble}}},
  booktitle = {Machine {{Learning}} and {{Knowledge Discovery}} in {{Databases}}},
  author = {Webb, Andrew and Reynolds, Charles and Chen, Wenlin and Reeve, Henry and Iliescu, Dan and Luj{\'a}n, Mikel and Brown, Gavin},
