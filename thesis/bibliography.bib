@article{carpenterMissingDataStatistical2021,
  title = {Missing Data: {{A}} Statistical Framework for Practice},
  shorttitle = {Missing Data},
  author = {Carpenter, James R. and Smuk, Melanie},
  year = {2021},
  journal = {Biometrical Journal},
  volume = {63},
