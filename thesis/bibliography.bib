@book{quinonero-candelaDatasetShiftMachine2008,
  title = {Dataset {{Shift}} in {{Machine Learning}}},
  editor = {{Qui{\~n}onero-Candela}, Joaquin and Sugiyama, Masashi and Schwaighofer, Anton and Lawrence, Neil D.},
  year = {2008},
  month = dec,
