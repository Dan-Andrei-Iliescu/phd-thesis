@misc{shahCounterfactualInferenceUnobserved2023,
  title = {On Counterfactual Inference with Unobserved Confounding},
  author = {Shah, Abhin and Dwivedi, Raaz and Shah, Devavrat and Wornell, Gregory W.},
  year = {2023},
  month = sep,
  number = {arXiv:2211.08209},
  eprint = {2211.08209},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2211.08209},
  urldate = {2025-03-10},
  abstract = {Given an observational study with \$n\$ independent but heterogeneous units, our goal is to learn the counterfactual distribution for each unit using only one \$p\$-dimensional sample per unit containing covariates, interventions, and outcomes. Specifically, we allow for unobserved confounding that introduces statistical biases between interventions and outcomes as well as exacerbates the heterogeneity across units. Modeling the conditional distribution of the outcomes as an exponential family, we reduce learning the unit-level counterfactual distributions to learning \$n\$ exponential family distributions with heterogeneous parameters and only one sample per distribution. We introduce a convex objective that pools all \$n\$ samples to jointly learn all \$n\$ parameter vectors, and provide a unit-wise mean squared error bound that scales linearly with the metric entropy of the parameter space. For example, when the parameters are \$s\$-sparse linear combination of \$k\$ known vectors, the error is \$O(s{\textbackslash}log k/p)\$. En route, we derive sufficient conditions for compactly supported distributions to satisfy the logarithmic Sobolev inequality. As an application of the framework, our results enable consistent imputation of sparsely missing covariates.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Statistics - Methodology},
  file = {C\:\\Users\\danan\\Zotero\\storage\\L8FS4DXD\\Shah et al. - 2023 - On counterfactual inference with unobserved confounding.pdf;C\:\\Users\\danan\\Zotero\\storage\\DGG3T3VH\\2211.html}
