\@writefile{lot}{\contentsline {table}{\numberline {1.1}{\ignorespaces Our CxVAE model outperforms existing methods at disentanglement on the \texttt  {Shift3DIdent} and \texttt  {TestScores} datasets. The competing models are: GVAE \citep  {hosoyaGroupbasedLearningDisentangled2019}, AdaGVAE \citep  {locatelloWeaklySupervisedDisentanglementCompromises2020}, and COCO-FUNIT \citep  {saitoCOCOFUNITFewShotUnsupervised2020}. The improvement in scores brought by our model is greater than the 95\% confidence interval around each score. Confidence intervals are computed by resampling train-test splits, weight initialisations and sampling seeds. All results are shown multiplied by 100.}}{15}{table.caption.17}\protected@file@percent }
\@writefile{brf}{\backcite{hosoyaGroupbasedLearningDisentangled2019}{{15}{1.1}{table.caption.17}}}
\@writefile{brf}{\backcite{locatelloWeaklySupervisedDisentanglementCompromises2020}{{15}{1.1}{table.caption.17}}}
\@writefile{brf}{\backcite{saitoCOCOFUNITFewShotUnsupervised2020}{{15}{1.1}{table.caption.17}}}
\newlabel{table:results}{{1.1}{15}{Our CxVAE model outperforms existing methods at disentanglement on the \texttt {Shift3DIdent} and \texttt {TestScores} datasets. The competing models are: GVAE \citep {hosoyaGroupbasedLearningDisentangled2019}, AdaGVAE \citep {locatelloWeaklySupervisedDisentanglementCompromises2020}, and COCO-FUNIT \citep {saitoCOCOFUNITFewShotUnsupervised2020}. The improvement in scores brought by our model is greater than the 95\% confidence interval around each score. Confidence intervals are computed by resampling train-test splits, weight initialisations and sampling seeds. All results are shown multiplied by 100}{table.caption.17}{}}
