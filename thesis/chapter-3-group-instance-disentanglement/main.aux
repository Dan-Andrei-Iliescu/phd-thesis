\newlabel{fig:data}{{1.3a}{11}{Test scores by school}{figure.caption.10}{}}
\newlabel{sub@fig:data}{{a}{11}{Test scores by school}{figure.caption.10}{}}
\newlabel{fig:trans_theirs}{{1.3b}{11}{Failed translation (GVAE)}{figure.caption.10}{}}
\newlabel{sub@fig:trans_theirs}{{b}{11}{Failed translation (GVAE)}{figure.caption.10}{}}
