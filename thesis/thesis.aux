\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Causal diagram for the variables involved in the diabetes risk model. A major cause of type-2 diabetes, $\MakeUppercase    []{y}$, is a high body-mass index, $\MakeUppercase    []{x}_{c}$, which itself is affected by whether the patient has a diet rich in salt, $W$. The frequency of thirst, $\MakeUppercase    []{x}_{s}$, is symptom of both diabetes, $\MakeUppercase    []{y}$, and a salt-rich diet, $\MakeUppercase    []{w}$. The environments in this case correspond to different groups of patients organised by diet.}}{86}{figure.caption.53}\protected@file@percent }
\newlabel{fig:diabetes}{{5.1}{86}{Causal diagram for the variables involved in the diabetes risk model. A major cause of type-2 diabetes, $\myrv {y}$, is a high body-mass index, $\myrv {x}_{c}$, which itself is affected by whether the patient has a diet rich in salt, $W$. The frequency of thirst, $\myrv {x}_{s}$, is symptom of both diabetes, $\myrv {y}$, and a salt-rich diet, $\myrv {w}$. The environments in this case correspond to different groups of patients organised by diet}{figure.caption.53}{}}
