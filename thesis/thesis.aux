\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Probabilistic graphical model comparing the latent inference models of Information Bottleneck \citep  {tishby2000information, achille2018emergence} and Domain-Content (mine). \textbf  {IB:} Learning a representation $\MakeUppercase    []{z}$ which is maximally predictive to the target variable $\MakeUppercase    []{x}$ whilst minimizing its mutual information with the source variable $\MakeUppercase    []{x}$. \citet  {achille2018emergence} show that this also implies minimizing its mutual information with the nuisance variable $\MakeUppercase    []{n}$. \textbf  {Domain-Content:} We want the inferred domain and content variables $\MakeUppercase    []{z}^q, \mathbf  {{\MakeUppercase    []{w}}}^q$ to be maximally informative of their data generating counterparts $\MakeUppercase    []{z}, \mathbf  {{\MakeUppercase    []{w}}}$ and minimally informative of each other's counterpart.}}{39}{figure.caption.10}\protected@file@percent }
\@writefile{brf}{\backcite{tishby2000information}{{39}{2.2}{figure.caption.10}}}
\@writefile{brf}{\backcite{achille2018emergence}{{39}{2.2}{figure.caption.10}}}
\@writefile{brf}{\backcite{achille2018emergence}{{39}{2.2}{figure.caption.10}}}
\newlabel{fig:nuisance}{{2.2}{39}{Probabilistic graphical model comparing the latent inference models of Information Bottleneck \citep {tishby2000information, achille2018emergence} and Domain-Content (mine). \textbf {IB:} Learning a representation $\myrv {z}$ which is maximally predictive to the target variable $\myrv {x}$ whilst minimizing its mutual information with the source variable $\myrv {x}$. \citet {achille2018emergence} show that this also implies minimizing its mutual information with the nuisance variable $\myrv {n}$. \textbf {Domain-Content:} We want the inferred domain and content variables $\myrv {z}^q, \mygroup {\myrv {w}}^q$ to be maximally informative of their data generating counterparts $\myrv {z}, \mygroup {\myrv {w}}$ and minimally informative of each other's counterpart}{figure.caption.10}{}}
