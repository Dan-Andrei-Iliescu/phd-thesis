\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Our probabilistic graphical model for the versatile imputation problem. Instance $k$ of the partial observation-group-group, $\MakeUppercase    []{y} \left [ \MakeUppercase    []{m} \right ]_k$, is generated by applying an instance of the missingness pattern, $\MakeUppercase    []{m}_k$, to an instance of the complete observation-group-group, $\MakeUppercase    []{y}_k$, with the missingness pattern. During training, only the complete observation-group-group, $\mathbf  {{\MakeUppercase    []{y}}}$, and the corresponding coordinates, $\mathbf  {{x}}$, are observed. During testing, only the partial observation-group-group, $\mathbf  {{\MakeUppercase    []{y}}} \left [ \mathbf  {{\MakeUppercase    []{m}}} \right ]$, the coordinates, $\mathbf  {{x}}$, and the missingness pattern, $\mathbf  {{\MakeUppercase    []{m}}}$, are observed.}}{70}{figure.caption.37}\protected@file@percent }
\newlabel{fig:mivae-pgm}{{4.3}{70}{Our probabilistic graphical model for the versatile imputation problem. Instance $k$ of the partial observation-group-group, $\myrv {y} \left [ \myrv {m} \right ]_k$, is generated by applying an instance of the missingness pattern, $\myrv {m}_k$, to an instance of the complete observation-group-group, $\myrv {y}_k$, with the missingness pattern. During training, only the complete observation-group-group, $\mygroup {\myrv {y}}$, and the corresponding coordinates, $\mygroup {\myvect {x}}$, are observed. During testing, only the partial observation-group-group, $\mygroup {\myrv {y}} \left [ \mygroup {\myrv {m}} \right ]$, the coordinates, $\mygroup {\myvect {x}}$, and the missingness pattern, $\mygroup {\myrv {m}}$, are observed}{figure.caption.37}{}}
