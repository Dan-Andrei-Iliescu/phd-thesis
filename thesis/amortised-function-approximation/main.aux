\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces Our model is robust to changes in the missingness pattern, whereas Masked CVAE only performs well when tested on the same missingness pattern as the one on which it was trained.\relax }}{13}{figure.caption.17}\protected@file@percent }
\newlabel{fig:robustness}{{1.5}{13}{Our model is robust to changes in the missingness pattern, whereas Masked CVAE only performs well when tested on the same missingness pattern as the one on which it was trained.\relax }{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces 4 control points are enough to bring our model's output significantly closer to the reference utterance. These are ratings in an A/B/R test where the question is ``Which of these is closer to the reference ground-truth control audio?''.\relax }}{13}{figure.caption.18}\protected@file@percent }
\newlabel{fig:faithfulness}{{1.6}{13}{4 control points are enough to bring our model's output significantly closer to the reference utterance. These are ratings in an A/B/R test where the question is ``Which of these is closer to the reference ground-truth control audio?''.\relax }{figure.caption.18}{}}
