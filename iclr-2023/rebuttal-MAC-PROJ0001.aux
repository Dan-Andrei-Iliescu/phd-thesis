\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Our CxVAE outperforms existing methods at disentangling between object-colour and spotlight-colour in the 3DIdent dataset \citep  {Zimmerman2021Contrastive}. Our model's MIG score is much higher than the one produced by competing models, and the performance gap is greater than the 95\% confidence interval for any one of these models. Confidence intervals are computed by resampling train-test splits, weight initialisations and sampling seeds.\relax }}{6}{table.caption.10}\protected@file@percent }
\newlabel{table:results}{{1}{6}{\change {Our CxVAE outperforms existing methods at disentangling between object-colour and spotlight-colour in the 3DIdent dataset \citep {Zimmerman2021Contrastive}. Our model's MIG score is much higher than the one produced by competing models, and the performance gap is greater than the 95\% confidence interval for any one of these models. Confidence intervals are computed by resampling train-test splits, weight initialisations and sampling seeds.}\relax }{table.caption.10}{}}
